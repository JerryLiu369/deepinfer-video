# Copy to .env and fill in. .env is never committed or zipped.
# Alibaba Cloud Bailian (DashScope) Qwen-Audio-3.1-TTS-Plus, used by tools/tts.py --backend qwen.
DASHSCOPE_API_KEY=sk-your-key
# Workspace-dedicated endpoint (the workspace whitelists the caller's IP).
DASHSCOPE_ENDPOINT=https://<your-workspace>.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
DASHSCOPE_MODEL=qwen-audio-3.1-tts-plus
# Optional. Unset or empty = direct connection. Set when egress must go through a whitelisted proxy:
# DASHSCOPE_PROXY=http://127.0.0.1:7890
# Optional. 1 (default) resolves hosts to IPv4 only, so a dual-stack machine does not leave via IPv6.
# DASHSCOPE_IPV4_ONLY=1
